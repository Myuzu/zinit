@test 'observed Git policy bounds unusually wide parent lists without crashing' {
    local count index tree tip
    local -a reply
    cooldown_graph_fixture
    tree=$(git -C "$COOLDOWN_REMOTE" rev-parse 'HEAD^{tree}')
    for count in 1 300 1000; do
        # Git accepts these objects. Do not let a repeated parent pattern
        # exhaust the shell's stack before the graph limits can hold it.
        tip=$({
            print -r -- "tree $tree"
            for (( index=0; index<count; ++index )); do
                print -r -- "parent $COOLDOWN_BASE"
            done
            print -r -- 'author zunit <zunit@localhost> 1600000000 +0000'
            print -r -- 'committer zunit <zunit@localhost> 1600000000 +0000'
            print
            print -r -- wide-parents
        } | git -C "$COOLDOWN_REMOTE" hash-object -t commit -w --stdin)
        git -C "$COOLDOWN_REMOTE" update-ref refs/heads/main "$tip"
        cooldown_graph_observe
        (( COOLDOWN_GRAPH_NOW += 864000 ))
        cooldown_graph_select
        assert $COOLDOWN_GRAPH_RC equals 0
        if (( count == 1 )); then
            assert $reply[1] same_as ready
            assert $reply[2] same_as "$tip"
        else
            assert $reply[1] same_as deferred
            assert $reply[4] same_as limit
            assert "$reply[5]" is_empty
            assert $reply[7] same_as "$tip"
            if (( count == 300 )); then
                assert $reply[6] same_as parents
                assert $reply[8] same_as 300
                assert $reply[9] same_as 256
            else
                assert $reply[6] same_as record-bytes
                assert $reply[9] same_as 32768
            fi
        fi
    done
}

@test 'observed Git policy bounds discovery while allowing small updates to long histories' {
    local count omitted object
    local -a reply
    cooldown_graph_fixture
    {
        print -r -- 'reset refs/heads/main'
        print -r -- "from $COOLDOWN_BASE"
        print
        for count in {1..15050}; do
            print -r -- 'commit refs/heads/main'
            print -r -- "committer zunit <zunit@localhost> $((1600000000 + count)) +0000"
            print -r -- 'data 6'
            print -r -- 'hidden'
            print
        done
    } | git -C "$COOLDOWN_REMOTE" fast-import --quiet
    git -C "$COOLDOWN_LOCAL" -c fetch.unpackLimit=20000 -c gc.auto=0 fetch --quiet origin main
    COOLDOWN_GRAPH_TIP=$(git -C "$COOLDOWN_LOCAL" rev-parse FETCH_HEAD)
    COOLDOWN_GRAPH_SNAPSHOT=( '' "$COOLDOWN_GRAPH_NOW" '' '' )
    cooldown_graph_select
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as limit
    assert "$reply[5]" is_empty
    assert $reply[6] same_as introduced-commits
    assert $reply[7] same_as "$COOLDOWN_GRAPH_TIP"
    assert $reply[8] same_as 10001
    assert $reply[9] same_as 10000
    # A missing object beyond the scan bound must not be read during Git's
    # setup, as happens with --topo-order or an exclusion range (^HEAD).
    omitted=$(git -C "$COOLDOWN_LOCAL" rev-parse "$COOLDOWN_GRAPH_TIP~14000")
    object="$COOLDOWN_LOCAL/.git/objects/${omitted[1,2]}/${omitted[3,-1]}"
    mv "$object" "$COOLDOWN_FIXTURE_DIR/omitted-object"
    cooldown_graph_select
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as limit
    assert "$reply[5]" is_empty
    mv "$COOLDOWN_FIXTURE_DIR/omitted-object" "$object"
    # The discovery limit must not require aging already installed history.
    COOLDOWN_GRAPH_HEAD=$(git -C "$COOLDOWN_LOCAL" rev-parse "$COOLDOWN_GRAPH_TIP^")
    git -C "$COOLDOWN_LOCAL" update-ref refs/heads/main "$COOLDOWN_GRAPH_HEAD"
    cooldown_graph_observe
    (( COOLDOWN_GRAPH_NOW += 864000 ))
    cooldown_graph_select
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as ready
    assert $reply[2] same_as "$COOLDOWN_GRAPH_TIP"
}

