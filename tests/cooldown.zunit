        git -C "$COOLDOWN_LOCAL" -c commit.gpgsign=false commit-tree "$COOLDOWN_GRAPH_TIP^{tree}" -p "$COOLDOWN_BASE" -m substitute)
    git -C "$COOLDOWN_LOCAL" replace "$COOLDOWN_GRAPH_TIP" "$replacement"
    GIT_GRAFT_FILE=$COOLDOWN_FIXTURE_DIR/grafts
    print -r -- "$COOLDOWN_GRAPH_TIP $COOLDOWN_BASE" > "$GIT_GRAFT_FILE"
    git -C "$COOLDOWN_LOCAL" config advice.graftFileDeprecated false
    git -C "$COOLDOWN_LOCAL" config log.showSignature true
    git -C "$COOLDOWN_LOCAL" config log.showNotes true
    IFS=:
    cooldown_graph_select pin
    IFS=$original_ifs
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as age
    assert $reply[5] same_as 1900864000
    assert "$GIT_GRAFT_FILE" same_as "$COOLDOWN_FIXTURE_DIR/grafts"
    assert "$(git -C "$COOLDOWN_LOCAL" show -s --format=%ct "$COOLDOWN_GRAPH_TIP")" same_as 1600000000
}

@test 'alternate or transient shallow boundaries cannot hide a young merged ancestor' {
    local tree parent side merge snapshot GIT_SHALLOW_FILE
    local -a reply
    cooldown_graph_fixture
    tree=$(git -C "$COOLDOWN_REMOTE" rev-parse 'HEAD^{tree}')
    parent=$(GIT_AUTHOR_DATE='@1900000000 +0000' GIT_COMMITTER_DATE='@1900000000 +0000' \
        git -C "$COOLDOWN_REMOTE" commit-tree "$tree" -p "$COOLDOWN_BASE" -m future-parent)
    side=$(GIT_AUTHOR_DATE='@1600000000 +0000' GIT_COMMITTER_DATE='@1600000000 +0000' \
        git -C "$COOLDOWN_REMOTE" commit-tree "$tree" -p "$parent" -m backdated-child)
    merge=$(GIT_AUTHOR_DATE='@1600000000 +0000' GIT_COMMITTER_DATE='@1600000000 +0000' \
        git -C "$COOLDOWN_REMOTE" commit-tree "$tree" -p "$COOLDOWN_BASE" -p "$side" -m backdated-merge)
    git -C "$COOLDOWN_REMOTE" update-ref refs/heads/main "$merge"
    git -C "$COOLDOWN_REMOTE" update-ref refs/heads/side "$side"
    cooldown_graph_observe
    COOLDOWN_GRAPH_NOW=1800864000
    cooldown_graph_select pin
    assert $reply[1] same_as deferred
    assert $reply[5] same_as 1900864000
    export GIT_SHALLOW_FILE=$COOLDOWN_FIXTURE_DIR/alternate-shallow
    print -r -- "$side" > "$GIT_SHALLOW_FILE"
    cooldown_graph_select pin
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as age
    assert $reply[5] same_as 1900864000
    assert "$GIT_SHALLOW_FILE" same_as "$COOLDOWN_FIXTURE_DIR/alternate-shallow"
    unset GIT_SHALLOW_FILE

    # These real fetches model another process changing then restoring shallow
    # state during discovery. It cannot inherit the selector's private view.
    mkdir "$COOLDOWN_FIXTURE_DIR/shim"
    local -x COOLDOWN_GRAPH_REAL_GIT=${commands[git]} COOLDOWN_GRAPH_REPO=$COOLDOWN_LOCAL
    local -x COOLDOWN_GRAPH_MARKER=$COOLDOWN_FIXTURE_DIR/snapshot-path
    cat > "$COOLDOWN_FIXTURE_DIR/shim/git" <<'EOF'
#!/bin/sh
for argument do
    if [ "$argument" = --timestamp ]; then
        printf '%s\n' "$GIT_SHALLOW_FILE" > "$COOLDOWN_GRAPH_MARKER"
        (unset GIT_SHALLOW_FILE; "$COOLDOWN_GRAPH_REAL_GIT" -C "$COOLDOWN_GRAPH_REPO" fetch --quiet --depth=1 origin side) || exit 72
        "$COOLDOWN_GRAPH_REAL_GIT" "$@"
        result=$?
        (unset GIT_SHALLOW_FILE; "$COOLDOWN_GRAPH_REAL_GIT" -C "$COOLDOWN_GRAPH_REPO" fetch --quiet --unshallow origin main) || exit 73
        exit "$result"
    fi
done
exec "$COOLDOWN_GRAPH_REAL_GIT" "$@"
EOF
    chmod 700 "$COOLDOWN_FIXTURE_DIR/shim/git"
    local -a path=( "$COOLDOWN_FIXTURE_DIR/shim" "${path[@]}" )
    cooldown_graph_select pin
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as age
    assert $reply[5] same_as 1900864000
    assert "$(git -C "$COOLDOWN_LOCAL" rev-parse HEAD)" same_as "$COOLDOWN_GRAPH_HEAD"
    run test ! -e "$COOLDOWN_LOCAL/.git/shallow"
    assert $state equals 0
    snapshot=$(<"$COOLDOWN_GRAPH_MARKER")
    assert "$snapshot" is_not_empty
    run test ! -e "$snapshot"
    assert $state equals 0
}

