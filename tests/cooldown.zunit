@test 'promisor configurations hold before any command can lazily fetch objects' {
    local key trace
    local -a reply
    cooldown_graph_fixture
    cooldown_commit update 1700000001
    cooldown_graph_observe
    COOLDOWN_GRAPH_NOW=1800864000
    cooldown_graph_select
    assert $reply[1] same_as ready
    local -x GIT_TRACE=$COOLDOWN_FIXTURE_DIR/git-trace
    for key in remote.origin.promisor remote.cache.promisor remote.cache.partialCloneFilter extensions.partialClone; do
        git -C "$COOLDOWN_LOCAL" config "$key" true
        # Git can retain an earlier true even when a later setting is false.
        if [[ $key = *.promisor ]]; then
            git -C "$COOLDOWN_LOCAL" config --add "$key" false
        fi
        : > "$GIT_TRACE"
        cooldown_graph_select
        assert $COOLDOWN_GRAPH_RC equals 0
        assert $reply[1] same_as deferred
        assert $reply[4] same_as partial
        assert "$reply[5]" is_empty
        trace=$(<"$GIT_TRACE")
        assert "$trace" does_not_contain rev-parse
        assert "$trace" does_not_contain rev-list
        assert "$trace" does_not_contain fetch
        git -C "$COOLDOWN_LOCAL" config --unset-all "$key"
    done
    git -C "$COOLDOWN_LOCAL" config remote.origin.promisor true
    : > "$COOLDOWN_FIXTURE_DIR/empty-config"
    local -x GIT_CONFIG=$COOLDOWN_FIXTURE_DIR/empty-config
    : > "$GIT_TRACE"
    cooldown_graph_select
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as deferred
    assert $reply[4] same_as partial
    assert "$GIT_CONFIG" same_as "$COOLDOWN_FIXTURE_DIR/empty-config"
    trace=$(<"$GIT_TRACE")
    assert "$trace" does_not_contain rev-parse
    assert "$trace" does_not_contain rev-list
    assert "$trace" does_not_contain fetch
    unset GIT_CONFIG
    git -C "$COOLDOWN_LOCAL" config remote.origin.promisor false
    cooldown_graph_select
    assert $COOLDOWN_GRAPH_RC equals 0
    assert $reply[1] same_as ready
}

